# ============================================================================
# Penlight-Dream-API - unofficial Garupa API server
# Copy to .env and edit.
# ============================================================================

# --- HTTP server ---
HOST=127.0.0.1
PORT=8080
API_PREFIX=/api
LOG_LEVEL=info

# Optional API key. When set, all /api/* requests must send it via
# X-API-Key header or Authorization: Bearer <key>. Leave empty to disable auth.
API_KEY=

# --- Upstream request timeout (ms) ---
GARUPA_HTTP_TIMEOUT_MS=10000

# --- Cache TTLs (seconds) ---
GARUPA_CACHE_TTL_RANKING=30
GARUPA_CACHE_TTL_MASTER=3600
GARUPA_CACHE_TTL_USER=300
GARUPA_VERSION_TTL_SECONDS=3600

# ============================================================================
# JP game server configuration.
# This project targets the JP server only.
# ============================================================================

# Server host. Use a bare hostname or a full URL; "api/" is appended for bare hostnames.
GARUPA_SERVER_BASES=api.garupa.jp

# Player UID used to build ranking request paths. 填写你自己的 UID。
GARUPA_UIDS=

# X-Signature header value, the device UUID. 填写你自己的设备 UUID。
GARUPA_UUIDS=

# AES-128-CBC encryption key, must be exactly 16 bytes. 填写你自己的密钥。
GARUPA_ENCRYPTION_KEYS=

# AES-128-CBC initialization vector, must be exactly 16 bytes. 填写你自己的 IV。
GARUPA_ENCRYPTION_IVS=

# 客户端版本通过 App Store lookup 自动探测，游戏更新后会自动跟随最新版本，
# 无需手动配置。如需手动指定，可设置 GARUPA_CLIENT_VERSIONS 作为探测失败时的回退。
# Unity 版本与 User-Agent 使用代码内置默认值，User-Agent 自动跟随 Unity 版本，
# 如需覆盖可分别设置 GARUPA_UNITY_VERSIONS、GARUPA_USER_AGENTS。
# X-ClientPlatform header.
GARUPA_CLIENT_PLATFORMS=iOS

# App Store lookup URL used to auto-detect the current client version.
GARUPA_PACKAGE_URLS=https://itunes.apple.com/jp/lookup?bundleId=jp.co.craftegg.band
